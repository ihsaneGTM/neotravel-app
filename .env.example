# === NeoTravel — modèle de variables d'environnement (à copier en .env.local) ===
AI_GATEWAY_API_KEY=vck_xxx              # Vercel AI Gateway
LLM_MODEL=anthropic/claude-sonnet-4.5   # modèle Claude via gateway

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # serveur uniquement

RESEND_API_KEY=re_xxx                   # clé Resend (resend.com → API Keys)
EMAIL_FROM="NeoTravel <devis@ton-domaine.fr>"  # ⚠️ domaine VÉRIFIÉ dans Resend, sinon envoi limité à l'adresse du compte
EMAIL_TEST_TO=demo@neotravel.test

CRON_SECRET=une-chaine-aleatoire        # protège /api/cron/relances — génère-la (openssl rand -hex 32), même valeur en local ET sur Vercel

# === Studio (auto-amélioration de l'app par IA) ===
STUDIO_API_KEY=sk-ant-xxx               # clé Anthropic DÉDIÉE (différente du chat) — Claude Opus
GITHUB_TOKEN=ghp_xxx                    # PAT (Contents+Deployments) sur le repo, pour brancher/committer/merger
GITHUB_REPO=ihsaneGTM/neotravel-app     # repo cible
NEXT_PUBLIC_PROD_URL=https://neotravel-app-fefd.vercel.app  # URL prod (before/after)
